{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/photos/:path*",
      "destination": "https://pub-1036c8427b654e5e900cbfb6f0bedbbe.r2.dev/:path*"
    }
  ],
  "headers": [
    {
      "source": "/photos/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "max-age=31536000" },
